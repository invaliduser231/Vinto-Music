# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Bot token from the Fluxer developer portal.
BOT_TOKEN=

# Password the bot uses to authenticate against NodeLink.
# Any value works as long as it matches on both sides. NodeLink is not exposed
# outside the compose network. Generate one with: openssl rand -hex 24
NODELINK_PASSWORD=

# Fluxer user id of the bot operator. Unlocks owner only commands (diag, eval).
BOT_OWNER_USER_ID=

# ---------------------------------------------------------------------------
# Images
# ---------------------------------------------------------------------------

# Prebuilt image of this project. Replace with your own registry if you build
# the Dockerfile yourself. Pin a specific build with ...:sha-<commit>
APP_IMAGE=ghcr.io/invaliduser231/vinto-music:latest

# NodeLink build used for audio resolution.
#
# This points at a fork rather than performanc/nodelink because upstream routes
# Deezer through a seekable range reader that skips Blowfish decryption, which
# makes playback scratchy and roughly a third too fast. The fork applies the
# decryption in the source worker. Once that fix lands upstream, the official
# image works just as well.
NODELINK_IMAGE=ghcr.io/invaliduser231/nodelink:dev

# ---------------------------------------------------------------------------
# Basics
# ---------------------------------------------------------------------------

PREFIX=!
LOG_LEVEL=info

# Default reply language for new guilds: en, de or pt-BR.
# Users can override it per user, guild admins per guild.
DEFAULT_LANGUAGE=en

MONGODB_DB=fluxer_music_bot

# Health and metrics endpoint. Bound to 127.0.0.1 by the compose file. To reach
# it remotely, put a reverse proxy with authentication in front of it.
MONITORING_PORT=9091

# ---------------------------------------------------------------------------
# Music sources
#
# All optional. A source without credentials simply stays inactive; the bot
# falls back to the remaining ones.
# ---------------------------------------------------------------------------

# ARL cookie of a logged in Deezer account. Used by the bot and by NodeLink.
DEEZER_ARL=
DEEZER_TRACK_FORMATS=MP3_128,MP3_64

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_MARKET=US

APPLE_MUSIC_MEDIA_API_TOKEN=
APPLE_MUSIC_AUTO_TOKEN=1
APPLE_MUSIC_MARKET=US

TIDAL_TOKEN=
TIDAL_COUNTRY_CODE=US

SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_AUTO_CLIENT_ID=1

# Track recognition for radio streams. Paid third party service.
AUDD_API_TOKEN=

# ---------------------------------------------------------------------------
# Limits
# ---------------------------------------------------------------------------

MAX_PLAYLIST_TRACKS=25
MAX_QUEUE_SIZE=100
MAX_FAVORITES_PER_USER=500
SEARCH_RESULT_LIMIT=5
PLAY_COMMAND_COOLDOWN_MS=2000
SESSION_IDLE_MS=300000
DEFAULT_VOLUME_PERCENT=100

# ---------------------------------------------------------------------------
# FluxerList integration
#
# Only relevant if the bot is listed on fluxerlist.com. Both features need an
# API key issued to the bot owner.
# ---------------------------------------------------------------------------

FLUXERLIST_STATS_ENABLED=0
FLUXERLIST_API_KEY=
FLUXERLIST_BOT_ID=

# Raises per user limits for people who voted for the bot. Voting is one time
# and permanent. Without an API key everything stays at the base limits, so
# nobody is ever locked out of a feature.
VOTE_REWARDS_ENABLED=0
VOTE_URL=

# ---------------------------------------------------------------------------
# YouTube
# ---------------------------------------------------------------------------

ENABLE_YT_SEARCH=1
ENABLE_YT_PLAYBACK=1
YTDLP_YOUTUBE_CLIENT=mweb

# Outbound proxy for hosts whose IP YouTube has flagged. Symptom is
# "Sign in to confirm you're not a bot" in the logs.
YTDLP_PROXY_URL=

# ---------------------------------------------------------------------------
# Error reporting
# ---------------------------------------------------------------------------

SENTRY_DSN=
SENTRY_ENVIRONMENT=production
