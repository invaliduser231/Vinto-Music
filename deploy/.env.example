# =============================================================================
# Vinto Music, self hosted configuration
#
# Everything except the three values under "Required" is optional. The compose
# file and the application fall back to the values shown here, so you only need
# to touch what you actually want to change.
# =============================================================================

# -----------------------------------------------------------------------------
# Required
# -----------------------------------------------------------------------------

# Bot token from the Fluxer developer portal.
BOT_TOKEN=

# Password shared between the bot and NodeLink. Any value works as long as it is
# identical on both sides. Generate one with: openssl rand -hex 24
NODELINK_PASSWORD=

# Fluxer user id of the operator. Unlocks owner only commands (diag, eval).
BOT_OWNER_USER_ID=

# -----------------------------------------------------------------------------
# Container images
# -----------------------------------------------------------------------------

APP_IMAGE=ghcr.io/invaliduser231/vinto-music:latest

# NodeLink build used for audio resolution.
#
# This points at a fork rather than performanc/nodelink because upstream routes
# Deezer through a seekable range reader that skips Blowfish decryption, which
# makes playback scratchy and roughly a third too fast. The fork applies the
# decryption inside the source worker. Once that lands upstream, the official
# image works just as well.
NODELINK_IMAGE=ghcr.io/invaliduser231/nodelink:dev

BGUTIL_POT_PROVIDER_IMAGE=brainicism/bgutil-ytdlp-pot-provider:1.3.1-node

# -----------------------------------------------------------------------------
# Basics
# -----------------------------------------------------------------------------

PREFIX=!
LOG_LEVEL=info
NODE_OPTIONS=--max-old-space-size=1024 --openssl-legacy-provider

# Reply language for guilds that never picked one: en, de or pt-BR.
# Users override it per user, admins per guild.
DEFAULT_LANGUAGE=en

ENABLE_EMBEDS=1

# Also react to the default prefix when a guild configured its own.
ALLOW_DEFAULT_PREFIX_FALLBACK=0

# -----------------------------------------------------------------------------
# Fluxer API and gateway
# -----------------------------------------------------------------------------

API_BASE=https://api.fluxer.app/v1
GATEWAY_URL=wss://gateway.fluxer.app
GATEWAY_INTENTS=0
GATEWAY_PRESENCE_ENABLED=0

# Ask the API for the gateway URL instead of using GATEWAY_URL verbatim.
AUTO_GATEWAY_URL=1

# Run gateway only, without REST. Diagnostic setting, normally off.
GATEWAY_ONLY_MODE=0

# Abort startup when the API is unreachable instead of retrying in background.
STRICT_STARTUP_CHECK=0

API_CHECK_RETRIES=5
API_CHECK_DELAY_MS=1000
REST_TIMEOUT_MS=10000
REST_MAX_RETRIES=4
REST_RETRY_BASE_DELAY_MS=300

# ipv4first avoids slow AAAA lookups on hosts without working IPv6.
DNS_RESULT_ORDER=ipv4first

# -----------------------------------------------------------------------------
# Storage
#
# The compose file ships a MongoDB container and already points the bot at it.
# Set MONGODB_URI only to use an external database such as Atlas.
# -----------------------------------------------------------------------------

# MONGODB_URI=mongodb+srv://user:password@cluster.example.net/?appName=Vinto
MONGODB_DB=fluxer_music_bot
MONGODB_MAX_POOL_SIZE=20
MONGODB_MIN_POOL_SIZE=5
MONGODB_CONNECT_TIMEOUT_MS=10000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
MONGODB_PING_INTERVAL_MS=15000

GUILD_CONFIG_CACHE_TTL_MS=60000
GUILD_CONFIG_CACHE_MAX_SIZE=5000

# -----------------------------------------------------------------------------
# Sessions and queue
# -----------------------------------------------------------------------------

# Leave voice after this much inactivity unless 24/7 mode is on.
SESSION_IDLE_MS=300000
MAX_CONCURRENT_VOICE_CHANNELS_PER_GUILD=5

SESSION_SNAPSHOT_MIN_WRITE_INTERVAL_MS=10000
SESSION_SNAPSHOT_FLUSH_INTERVAL_MS=30000
SESSION_SNAPSHOT_MAX_PENDING_TRACKS=25

MAX_QUEUE_SIZE=100

# How many tracks a single playlist link may enqueue.
MAX_PLAYLIST_TRACKS=25

MAX_SAVED_PLAYLISTS_PER_GUILD=100
MAX_SAVED_TRACKS_PER_PLAYLIST=500
MAX_FAVORITES_PER_USER=500
PERSISTENT_HISTORY_SIZE=200

DEFAULT_DEDUPE_ENABLED=0
DEFAULT_247_ENABLED=0
VOTE_SKIP_RATIO=0.5
VOTE_SKIP_MIN_VOTES=2

# -----------------------------------------------------------------------------
# Playback
# -----------------------------------------------------------------------------

DEFAULT_VOLUME_PERCENT=100
MIN_VOLUME_PERCENT=0
MAX_VOLUME_PERCENT=200
VOICE_MAX_BITRATE=192000

PLAY_COMMAND_COOLDOWN_MS=2000
SEARCH_RESULT_LIMIT=5
SEARCH_PICK_TIMEOUT_MS=45000

# Very noisy, for debugging playback problems only.
PLAYBACK_DIAGNOSTICS_ENABLED=0
PLAYBACK_DIAGNOSTICS_INTERVAL_MS=1000

# -----------------------------------------------------------------------------
# NodeLink, bot side
#
# How the bot talks to NodeLink. NodeLink's own settings use the
# NODELINK_SERVER_* and NODELINK_SOURCES_* names further below.
# -----------------------------------------------------------------------------

NODELINK_ENABLED=1

# smart         resolve through NodeLink where it helps, local pipeline otherwise
# all           route everything through NodeLink
# youtube-only  only YouTube goes through NodeLink
NODELINK_ROUTING_MODE=smart

NODELINK_DEFAULT_SEARCH=deezer
NODELINK_REQUEST_TIMEOUT_MS=15000

# Raise this if tracks fail to start on a slow host.
NODELINK_STREAM_START_TIMEOUT_MS=10000

# -----------------------------------------------------------------------------
# NodeLink, server side
#
# Passed into the NodeLink container. Anything not listed keeps NodeLink's own
# default. Lists accept either a JSON array or a comma separated string.
#
# Names mirror NodeLink's config tree: search.maxResults becomes
# NODELINK_SEARCH_MAXRESULTS. A name that does not match the tree is silently
# ignored, so double check against config.default.ts when adding one.
# -----------------------------------------------------------------------------

NODELINK_SEARCH_MAXRESULTS=10
NODELINK_SEARCH_DEFAULTSOURCE=deezer,soundcloud,tidal,jiosaavn
NODELINK_SEARCH_UNIFIEDSOURCES=deezer,soundcloud,tidal,jiosaavn
NODELINK_SOURCES_YOUTUBE_FALLBACKSOURCES=soundcloud,deezer,jiosaavn,tidal

# Solves YouTube signature ciphers. Without it YouTube playback can fail.
NODELINK_SOURCES_YOUTUBE_CIPHER_URL=https://cipher.kikkia.dev/api

# Internal YouTube clients to try, in order. Keeping ANDROID_VR out of the list
# avoids the recurring "No streaming data found" failures.
NODELINK_SOURCES_YOUTUBE_CLIENTS_PLAYBACK=["VisionOs","TV_DOWN","TV","WebEmbedded","IOS","Web"]
NODELINK_SOURCES_YOUTUBE_CLIENTS_RESOLVE=["VisionOs","TV_DOWN","TV","WebEmbedded","IOS","Web"]
NODELINK_SOURCES_YOUTUBE_CLIENTS_SEARCH=["Android"]

# Outbound proxies for NodeLink itself, as a JSON array. Use when the host IP is
# blocked by YouTube. A proxy that is configured but unreachable is worse than
# none at all, because every attempt then fails with ECONNREFUSED instead of
# trying a direct connection. Verify before setting it:
#   curl -sS --max-time 5 -x http://host:port https://www.youtube.com -o /dev/null -w '%{http_code}'
# NODELINK_SOURCES_YOUTUBE_PROXIES=[{"url":"http://proxy.example:8080","type":"reverse"}]

# OAuth refresh token of a YouTube TV session, as a JSON array. This usually
# lifts the "No streaming data found" blocks without needing a proxy at all,
# because requests are then authenticated rather than anonymous.
# NODELINK_SOURCES_YOUTUBE_CLIENTS_SETTINGS_TV_REFRESHTOKEN=["your-refresh-token"]

# Start an interactive device login on boot to obtain such a token. Watch the
# container log for the code, then set the token above and turn this off again.
NODELINK_SOURCES_YOUTUBE_GETOAUTHTOKEN=false

# Maximum tracks NodeLink loads from one album or playlist.
NODELINK_PLAYBACK_MAXPLAYLISTLENGTH=100

# error, warn, info or debug
NODELINK_LOGGING_LEVEL=info

# -----------------------------------------------------------------------------
# Music sources
#
# All optional. A source without credentials stays inactive and the bot falls
# back to the remaining ones.
# -----------------------------------------------------------------------------

# ARL cookie of a logged in Deezer account. Used by the bot and by NodeLink.
DEEZER_ARL=
DEEZER_TRACK_FORMATS=MP3_128,MP3_64
ENABLE_DEEZER_IMPORT=1

# Blowfish key NodeLink needs to decrypt Deezer streams. Without it every Deezer
# stream fails and the bot silently falls back to a YouTube match, which is
# usually the wrong recording. Must be exactly 16 characters.
NODELINK_SOURCES_DEEZER_DECRYPTIONKEY=

# -----------------------------------------------------------------------------
# External helper services
#
# NodeLink relies on a few third party endpoints for sources it cannot
# authenticate against on its own. They are not operated by this project, so
# they can go offline without warning. When one is down, that source stops
# working while everything else keeps running.
#
# Check whether one is reachable with: curl -sSI <url>
# -----------------------------------------------------------------------------

# Spotify token service, used only when SPOTIFY_CLIENT_ID and
# SPOTIFY_CLIENT_SECRET are empty. Setting your own credentials removes this
# dependency entirely and is the more reliable option.
# NODELINK_SOURCES_SPOTIFY_EXTERNALAUTHURL=http://get.1lucas1apk.fun/spotify/gettoken

# Pandora token service. Required for the Pandora source.
# NODELINK_SOURCES_PANDORA_REMOTETOKENURL=https://get.1lucas1apk.fun/pandora/gettoken

# Solves YouTube signature ciphers. Without a working endpoint YouTube playback
# fails for most videos.
# NODELINK_SOURCES_YOUTUBE_CIPHER_URL=https://cipher.kikkia.dev/api

# Mirror used by the EternalBox source.
# NODELINK_SOURCES_ETERNALBOX_BASEURL=https://eternalboxmirror.xyz

# SponsorBlock API, used to skip sponsor segments in YouTube tracks.
# NODELINK_PLAYBACK_SPONSORBLOCK_API=https://sponsor.ajay.app

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
SPOTIFY_MARKET=US
ENABLE_SPOTIFY_IMPORT=1

APPLE_MUSIC_MEDIA_API_TOKEN=
APPLE_MUSIC_AUTO_TOKEN=1
APPLE_MUSIC_MARKET=US

TIDAL_TOKEN=
TIDAL_COUNTRY_CODE=US
ENABLE_TIDAL_IMPORT=1

SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_AUTO_CLIENT_ID=1

# Track recognition for radio streams. Paid third party service.
AUDD_API_TOKEN=

# Refuse to start when a configured source has invalid credentials, instead of
# disabling that source and continuing.
STRICT_MEDIA_AUTH=0

# -----------------------------------------------------------------------------
# YouTube and yt-dlp
# -----------------------------------------------------------------------------

ENABLE_YT_SEARCH=1
ENABLE_YT_PLAYBACK=1
YTDLP_YOUTUBE_CLIENT=mweb
YOUTUBE_PLAYLIST_RESOLVER=ytdlp

# Outbound proxy for hosts whose IP YouTube flagged. The symptom in the logs is
# "Sign in to confirm you're not a bot".
YTDLP_PROXY_URL=

# Cookie file for age restricted or region locked videos. Mount the file into
# the container first, then point this at the path inside the container.
YTDLP_COOKIES_FILE=
YTDLP_COOKIES_FROM_BROWSER=

# Binary paths and plugin wiring come from the compose file. Override only when
# building your own image.
# FFMPEG_BIN=/usr/bin/ffmpeg
# YTDLP_BIN=/usr/local/bin/yt-dlp
# YTDLP_EXTRA_ARGS=

# -----------------------------------------------------------------------------
# Rate limiting
# -----------------------------------------------------------------------------

COMMAND_RATE_LIMIT_ENABLED=1
COMMAND_USER_WINDOW_MS=10000
COMMAND_USER_MAX=8
COMMAND_GUILD_WINDOW_MS=10000
COMMAND_GUILD_MAX=40
COMMAND_RATE_LIMIT_BYPASS=help,ping

# -----------------------------------------------------------------------------
# Monitoring and health
#
# The compose file binds this to 127.0.0.1. To reach it remotely, put a reverse
# proxy with authentication in front of it.
# -----------------------------------------------------------------------------

MONITORING_ENABLED=1
MONITORING_PORT=9091

# Exit after being unhealthy this long so the restart policy can recover.
UNHEALTHY_EXIT_ENABLED=1
UNHEALTHY_EXIT_AFTER_MS=180000
UNHEALTHY_CHECK_INTERVAL_MS=5000

# -----------------------------------------------------------------------------
# Memory
# -----------------------------------------------------------------------------

MEMORY_TELEMETRY_INTERVAL_MS=15000
MEMORY_TELEMETRY_LOG_INTERVAL_MS=300000

# Exit above this RSS so the container restarts. 0 disables the guard.
MEMORY_RSS_EXIT_MB=1536

HEAP_SNAPSHOT_SIGNAL_ENABLED=1
HEAP_SNAPSHOT_DIR=.heap-snapshots

# -----------------------------------------------------------------------------
# FluxerList
#
# Only relevant when the bot is listed on fluxerlist.com. Both features need an
# API key issued to the bot owner.
# -----------------------------------------------------------------------------

FLUXERLIST_STATS_ENABLED=0
FLUXERLIST_API_KEY=
FLUXERLIST_BOT_ID=
FLUXERLIST_API_BASE=https://fluxerlist.com
FLUXERLIST_STATS_INTERVAL_MS=600000

# Raises per user limits for people who voted. Voting is one time and permanent.
# Without an API key everything stays at the base limits, so nobody is ever
# locked out of a feature.
VOTE_REWARDS_ENABLED=0
VOTE_REFRESH_INTERVAL_MS=600000
VOTE_URL=

# -----------------------------------------------------------------------------
# Error reporting
# -----------------------------------------------------------------------------

SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# -----------------------------------------------------------------------------
# Container log rotation
# -----------------------------------------------------------------------------

APP_LOG_MAX_SIZE=50m
APP_LOG_MAX_FILE=5
