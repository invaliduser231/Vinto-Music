# ---------------------------------------------------------------------------
# Pflicht
# ---------------------------------------------------------------------------

# Bot-Token aus dem Fluxer Developer Portal
BOT_TOKEN=

# Passwort, mit dem sich der Bot bei NodeLink anmeldet.
# Frei wählbar, muss nur hier stehen - NodeLink ist nicht nach außen offen.
# Erzeugen: openssl rand -hex 24
NODELINK_PASSWORD=

# Deine Fluxer-User-ID (schaltet owner-only Befehle wie diag/eval frei)
BOT_OWNER_USER_ID=

# ---------------------------------------------------------------------------
# Image-Auswahl
# ---------------------------------------------------------------------------

# Nach dem Merge auf main:  ghcr.io/invaliduser231/vinto-music:latest
# Solange feature/nodelink: ghcr.io/invaliduser231/vinto-music:feature-nodelink
# Für ein festgenageltes Deployment: ...:sha-<commit>
APP_IMAGE=ghcr.io/invaliduser231/vinto-music:feature-nodelink

# WICHTIG: der eigene Fork, nicht performanc/nodelink.
# Nur dieser enthält den Deezer-Entschlüsselungs-Fix im Source-Worker.
NODELINK_IMAGE=ghcr.io/invaliduser231/nodelink:dev

# ---------------------------------------------------------------------------
# Grundeinstellungen
# ---------------------------------------------------------------------------

PREFIX=!
LOG_LEVEL=info
DEFAULT_LANGUAGE=en
MONGODB_DB=fluxer_music_bot

# Nur auf 127.0.0.1 erreichbar (siehe compose). Für Zugriff von außen
# einen Reverse Proxy mit Auth davorsetzen, niemals direkt öffnen.
MONITORING_PORT=9091

# ---------------------------------------------------------------------------
# Musikquellen (alles optional - ohne Angabe ist die Quelle inaktiv)
# ---------------------------------------------------------------------------

# Deezer: ARL-Cookie eines eingeloggten Kontos.
# Wird von Bot UND NodeLink genutzt.
DEEZER_ARL=
DEEZER_TRACK_FORMATS=MP3_128,MP3_64

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_MARKET=US

APPLE_MUSIC_MEDIA_API_TOKEN=
APPLE_MUSIC_AUTO_TOKEN=1
APPLE_MUSIC_MARKET=US

TIDAL_TOKEN=
TIDAL_COUNTRY_CODE=US

SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_AUTO_CLIENT_ID=1

# Radio-Erkennung (kostenpflichtig, optional)
AUDD_API_TOKEN=

# ---------------------------------------------------------------------------
# Limits
# ---------------------------------------------------------------------------

MAX_PLAYLIST_TRACKS=25
MAX_QUEUE_SIZE=100
MAX_FAVORITES_PER_USER=500
SEARCH_RESULT_LIMIT=5
PLAY_COMMAND_COOLDOWN_MS=2000
SESSION_IDLE_MS=300000
DEFAULT_VOLUME_PERCENT=100

# ---------------------------------------------------------------------------
# FluxerList: Statistik-Push und Vote-Vorteile
# ---------------------------------------------------------------------------

FLUXERLIST_STATS_ENABLED=0
FLUXERLIST_API_KEY=
FLUXERLIST_BOT_ID=

# Schaltet die Vorteile für Voter frei (nutzt FLUXERLIST_API_KEY mit).
# Ohne API-Key bleibt alles bei den Basiswerten - niemand wird ausgesperrt.
VOTE_REWARDS_ENABLED=0
VOTE_URL=

# ---------------------------------------------------------------------------
# YouTube
# ---------------------------------------------------------------------------

ENABLE_YT_SEARCH=1
ENABLE_YT_PLAYBACK=1
YTDLP_YOUTUBE_CLIENT=mweb

# Proxy gegen IP-Sperren ("Sign in to confirm you're not a bot")
YTDLP_PROXY_URL=

# ---------------------------------------------------------------------------
# Fehler-Reporting (optional)
# ---------------------------------------------------------------------------

SENTRY_DSN=
SENTRY_ENVIRONMENT=production
