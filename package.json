{
  "name": "fluxer-music-bot",
  "version": "0.16.1",
  "description": "Production-minded music bot for Fluxer with resilient playback, persistence, and monitoring.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/src/index.js",
    "dev": "node --import tsx --watch src/index.ts",
    "test": "node scripts/run-tests.mjs",
    "spotify:token": "node --import tsx scripts/get-spotify-refresh-token.ts"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "keywords": [
    "bot",
    "music",
    "fluxer",
    "livekit",
    "mongodb",
    "youtube",
    "soundcloud",
    "spotify",
    "deezer"
  ],
  "dependencies": {
    "@livekit/rtc-node": "^1.2.1",
    "@napi-rs/canvas": "^1.1.0",
    "@sentry/node": "^11.11.0",
    "dotenv": "^18.0.10",
    "egoroof-blowfish": "^4.0.3",
    "ffmpeg-static": "^5.3.0",
    "mongodb": "^7.8.0",
    "play-dl": "^1.9.7",
    "undici": "^8.12.4",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
